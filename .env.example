# StockSense Environment Configuration
PROJECT_NAME="StockSense Inventory POC"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (SQLite with WAL mode)
DATABASE_URL="sqlite:///./data/stocksense.db"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Seed & Synthetic Data Configuration
SYNTHETIC_DATA_SEED=42
DEFAULT_WAREHOUSE_CODE="WH-01"

# Security & Authentication (JWT Secret)
# IMPORTANT: In production, generate a secure random 32-byte secret (e.g. `openssl rand -hex 32`)
SECRET_KEY="stocksense-dev-secret-key-change-in-production-min-32-chars"

